# GEMINI_API_KEY: Required for Gemini AI API calls.
#
# IMPORTANT: this is a SERVER-ONLY variable. It is read exclusively by the
# serverless function at api/gemini.ts (process.env.GEMINI_API_KEY) and is
# NEVER shipped to the browser bundle.
#
# Do NOT prefix it with VITE_. Any VITE_-prefixed variable is inlined into the
# client bundle by Vite and would be publicly readable in the browser devtools.
#
# On Vercel: add GEMINI_API_KEY in Project Settings → Environment Variables.
# Locally: put it in .env.local (git-ignored).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGIN (optional): a custom production domain to allow in api/gemini.ts.
# localhost and *.vercel.app are already allowed by default.
# ALLOWED_ORIGIN="https://your-custom-domain.com"

# ACCESS_CODES: per-person PIN codes that gate access to the app (server-side).
# Format: comma-separated "name:code" pairs. The name is used for per-person
# rate limiting; the code is what each user types on the access screen.
# Removing a person's entry revokes their access on the next deployment.
# If ACCESS_CODES is unset, the API allows all requests (handy for local dev).
ACCESS_CODES="adri:4821,maria:7734,carlos:9156"
